# ---- Optional extra FREE providers for the agent (leave empty to skip; add any you sign up for) ----
# Story/script writers (tried after Groq → Gemini → OpenRouter)
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=
GITHUB_MODELS_TOKEN=
# Cloudflare Workers AI: script + FLUX images + backup voice (free daily allowance)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Hugging Face FLUX images
HF_TOKEN=
# Free STOCK VIDEO (real footage, labelled as stock). PEXELS_API_KEY above also works.
PIXABAY_API_KEY=
# Set to "off" to disable the key-less Pollinations text fallback
POLLINATIONS_KEYLESS_TEXT=
# ---- AI video (optional, PAID — only used when "Allow paid AI video" is on in Settings) ----
# FAL_KEY / REPLICATE_API_TOKEN also give access to Kling, Hailuo (MiniMax), Wan, Pika models.
LUMAAI_API_KEY=
RUNWAYML_API_SECRET=
# Optional overrides
GEMINI_IMAGE_MODEL=
# Background generation: CRON_SECRET (above) lets long videos keep rendering with the app closed.
# If Vercel Deployment Protection is on for production, also set this to your bypass secret:
VERCEL_AUTOMATION_BYPASS_SECRET=
# ---- More free AI (optional) ----
NVIDIA_API_KEY=
COHERE_API_KEY=
DEEPGRAM_API_KEY=
AI_HORDE_API_KEY=
